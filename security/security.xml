<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Record Rule: Dosen hanya dapat melihat/mengedit RPS milik mereka sendiri di portal -->
        <record id="rule_sirita_rps_lecturer" model="ir.rule">
            <field name="name">Dosen: RPS Sendiri</field>
            <field name="model_id" ref="model_sirita_rps"/>
            <field name="domain_force">['|', ('dosen_ids.user_id', '=', user.id), ('koordinator_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Record Rule: Admin dapat melihat/mengelola semua RPS -->
        <record id="rule_sirita_rps_all" model="ir.rule">
            <field name="name">Admin: Semua RPS</field>
            <field name="model_id" ref="model_sirita_rps"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>
